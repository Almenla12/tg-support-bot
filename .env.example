# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
GROUP_ID=-1001234567890
ADMIN_USERS_LIST=123456789,987654321

# Database Selection (mysql or sqlite)
DB_TYPE=sqlite

# MySQL Database Configuration (Required if DB_TYPE=mysql)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=password
DB_NAME=support_bot

# SQLite Database Configuration (Required if DB_TYPE=sqlite)
SQLITE_DB_PATH=bot_database.db
